# Boîte dédiée au rapport de dérive Evidently.
# Séparée de la boîte du pipeline : ses outils n'ont pas les mêmes versions.
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 HOME=/tmp
RUN python -m pip install "evidently==0.7.17" "pandas>=2.0" "numpy>=1.26" "psycopg[binary]==3.2.9"
COPY adhd/drift_report.py /app/drift_report.py
CMD ["python", "/app/drift_report.py"]
